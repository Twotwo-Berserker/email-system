# ============================================================
# 邮件系统 — 环境变量配置模板
# 使用说明: 复制此文件为 .env 并修改其中的值
#   cp .env.example .env
# ============================================================

# -------------------- MySQL 数据库 --------------------
# 【生产环境替换项】生产环境必须使用强密码，且不应使用 root 账号
MYSQL_ROOT_PASSWORD=root123
MYSQL_DATABASE=mail_system
MYSQL_USER=mailuser
MYSQL_PASSWORD=mailpass123

# -------------------- Redis 缓存 --------------------
# 【生产环境替换项】生产环境必须使用强密码，建议 32 位以上随机字符串
REDIS_PASSWORD=redis_secure_password_2026
# Redis 最大内存限制
REDIS_MAXMEMORY=256mb

# -------------------- MinIO 对象存储 --------------------
# 【生产环境替换项】生产环境必须使用强密码，建议 32 位以上随机字符串
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin123

# -------------------- JWT 认证 --------------------
# 【生产环境替换项】生产环境必须使用随机生成的密钥，长度至少 256 位
JWT_SECRET=mail-system-2026-secret-key-for-jwt-token-generation
# Token 有效期（毫秒），默认 24 小时 = 86400000
JWT_EXPIRATION=86400000

# -------------------- 凭据加密密钥（AES-256-GCM） --------------------
# 用于加密落库的邮箱授权码（mail_account.*_password_enc）与 LLM API Key（llm_config.api_key）
#
# 【生产环境替换项】必须替换为随机生成的 32 字节 Base64 密钥，生成方式：
#   openssl rand -base64 32
#
# ⚠️ 该值一旦变更，已加密的历史凭据将无法解密（应用会在解密时明确报错，
#    而不是静默失败），需要重新录入邮箱授权码与 API Key。请与数据库备份一同保管。
# ⚠️ 若留空，后端将<b>拒绝启动</b>并提示生成命令 —— 这是刻意的：
#    给一个硬编码默认密钥等价于不加密，而用随机临时密钥会导致重启后凭据静默损坏。
AES_SECRET_KEY=7psK68OB93SAaXA8r5VGFCYg+8OrtKSkPuIWe0bEUPo=

# -------------------- 管理员种子账号 --------------------
# 首次启动（或清库后重启）时由 AdminSeeder 幂等创建，角色 ADMIN、强制首次登录改密。
# 已存在同邮箱账号时不会覆盖其密码。
# 【生产环境替换项】生产环境必须使用强密码
ADMIN_INIT_EMAIL=admin@local.com
ADMIN_INIT_PASSWORD=123456

# -------------------- IMAP 收信轮询 --------------------
# 应用启动后首次同步前的等待（毫秒），避免与启动过程抢资源
IMAP_INITIAL_DELAY_MS=30000
# 轮询间隔（毫秒），默认 3 分钟。调小会增加外部邮箱服务商的连接频率，可能被限流。
IMAP_SYNC_INTERVAL_MS=180000
# 首次同步回溯天数（水位线为空时按此范围拉取）
IMAP_FETCH_DAYS=7
# 单次单账户最大拉取封数，防止首次同步把库拉爆
IMAP_MAX_FETCH_PER_RUN=200
# 登录后发送 IMAP ID 命令（RFC 2971）。【请勿改为 false】
# 网易系邮箱（163/126/yeah.net）要求客户端声明身份，不发则直接拒绝服务，
# 报错为难以理解的 "Unsafe Login. Please contact kefu@188.com"。
IMAP_SEND_CLIENT_ID=true

# -------------------- 邮箱绑定的连通性探测 --------------------
# 一键绑定时，后端会真实连接候选服务器，把连得通的那组配置落库。
# 超时显著短于正常收发：用户正对着转圈的按钮，且最多要试 3 个端点组合。
PROBE_CONNECT_TIMEOUT_MS=4000
PROBE_READ_TIMEOUT_MS=6000

# -------------------- 本域邮箱：收信（Cloudflare Email Routing） --------------------
# 这一组配置让本系统拥有自己的域名邮箱：外部邮件到达本项目域名后，
# Cloudflare 在边缘接收并推送给后端。系统从不登录任何外部邮箱，
# 因此这条链路<b>不涉及授权码</b>。部署步骤见 deploy/cloudflare/README.md
#
# 【不开也能正常用】留空/保持 false 时，本域邮箱入口不显示，
# 用户绑定外部邮箱的既有功能完全不受影响。
INBOUND_ENABLED=true

# 与 Cloudflare Worker 共享的密钥，用于校验来信来源（HMAC-SHA256）。
# 生成方式：openssl rand -hex 32
# ⚠️ 必须与 Worker 侧用 `wrangler secret put INBOUND_SHARED_SECRET` 写入的值完全一致。
# ⚠️ 没有它，/inbound/cloudflare 就是一个任何人都能往里塞邮件的匿名写接口。
INBOUND_SHARED_SECRET=d8148c326b06f2bcd92ef4beba5794db6c819d6cfd99fcf08d1565b7d78046c6

# 允许收信的域名，逗号分隔（如 mail.example.com）。
# 必须是已在 Cloudflare 上配好 Email Routing MX 记录的域名，
# 否则信根本到不了 —— 用户领了地址却收不到信，且两边都看不出问题。
INBOUND_DOMAINS=twotwomail.dpdns.org

# 单封信的原始报文上限（字节），默认 25MB
INBOUND_MAX_MESSAGE_BYTES=26214400

# -------------------- 本域邮箱：发信（项目级中继） --------------------
# Cloudflare Email Routing 只负责收信，不提供发信服务。
# 本域地址要能发信，必须有一条"以本项目域名为身份"的发信通道。
# 用的是项目自己的凭据，不是用户外部邮箱的授权码。
#
# 取值：none（不发信，默认）/ resend（HTTP API）/ smtp（自建或第三方 SMTP 中继）
OUTBOUND_TRANSPORT=resend

# --- 通道一：Resend（推荐，只需一个 API Key，走 443 不受主机商封禁出站端口影响）---
RESEND_API_KEY=

# --- 通道二：SMTP 中继（已有邮件服务器时用）---
RELAY_SMTP_HOST=
RELAY_SMTP_PORT=587
# 1=SSL(465), 0=STARTTLS(587)
RELAY_SMTP_SSL=0
# 允许匿名投递的中继可留空；留空时不会走 AUTH 流程
RELAY_SMTP_USERNAME=
RELAY_SMTP_PASSWORD=

# -------------------- SMTP / IMAP 协议代理 --------------------
# 让 Thunderbird、Outlook 等传统邮件客户端能访问本系统的邮箱。
# 代理的登录凭证是<b>本系统自己的账号密码</b>，不是外部邮箱的授权码。
# 用法见 proxy/README.md
PROXY_HOST=0.0.0.0
IMAP_PORT=143
SMTP_PORT=2525
# 打印每一个协议命令，排查客户端兼容性问题时打开
PROXY_VERBOSE=false

# -------------------- LLM 调用 --------------------
# 【重要】必须有超时。无超时 + 上游挂起会占满分析线程池，进而阻塞所有邮件的分析。
LLM_CONNECT_TIMEOUT_MS=5000
LLM_READ_TIMEOUT_MS=12000
# 每用户每分钟最大调用次数
LLM_RATE_LIMIT_PER_MINUTE=20
# 连续失败达到阈值后熔断，熔断期内直接走规则兜底，不再发起请求
LLM_CIRCUIT_BREAKER_THRESHOLD=5
LLM_CIRCUIT_BREAKER_OPEN_SECONDS=60

# -------------------- 邮件分析 --------------------
# 送 LLM 前的正文截断长度（字符），控制上下文与成本
ANALYSIS_MAX_CONTENT_CHARS=3000

# -------------------- 文件上传限制 --------------------
# 附件上传大小限制（字节），默认 50MB
FILE_UPLOAD_MAX_SIZE=52428800
# 请求体大小限制（字节），需大于附件限制
FILE_REQUEST_MAX_SIZE=104857600

# -------------------- 服务端口配置 --------------------
# 以下端口可根据宿主机端口占用情况调整
NGINX_PORT=80
BACKEND_PORT=8080
MYSQL_PORT=3306
REDIS_PORT=6379
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
